# ============================================================
# Môi trường cho toàn bộ dự án Repo (folderscaner + propack)
# Sao chép file này thành .env rồi sửa cho phù hợp với máy của bạn
# ============================================================

# --- FOLDERS CANNER (Backend + Frontend + DB) ---

# Đường dẫn thư mục chia sẻ SMB/UNC (bắt buộc)
# Ví dụ Windows: \\SERVER\THU_MUC
# Ví dụ thư mục cục bộ: ./folderscaner/test_smb_root
SMB_ROOT=./folderscaner/test_smb_root

# Thời gian quét lại (giây)
SCAN_INTERVAL=10

# Cổng backend FastAPI (trong container)
SERVER_PORT=18001

# Thông tin đăng nhập SMB (nếu cần)
SMB_USERNAME=
SMB_PASSWORD=
SMB_DOMAIN=

# --- PostgreSQL (cho folderscaner) ---
POSTGRES_USER=folder_user
POSTGRES_PASSWORD=folder_pass
POSTGRES_DB=folder_sync
